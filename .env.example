# Copy to .env (ignored by git); the application reads it on start (spring.config.import).
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/storepulse?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
# Generate one with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
FIREBASE_CREDENTIALS_PATH=
FIREBASE_MAIL_COLLECTION=mail
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Registers the demo gallery on the first start (dev: true by default; prod: false by default).
DEMO_DATA_ENABLED=true